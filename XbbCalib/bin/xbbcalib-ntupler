#!/bin/env python

#
# Copyright (C) 2002-2024 CERN for the benefit of the ATLAS collaboration
#

#
# Extends easyjet-ntupler with dihiggs-specific algorithms
#

import sys
import time
import warnings

from AnalysisAlgorithmsConfig.ConfigText import TextConfigWarning

from EasyjetHub.hub import (
    AnalysisArgumentParser,
    analysis_configuration,
    run_job,
    default_sequence_cfg,
    output_cfg
)
from EasyjetHub.output.ttree.minituple_config import check_ntuple_output_file

from XbbCalib.ttCalib_config import ttCalib_branches
from XbbCalib.ttCalib_config import ttCalib_cfg
from XbbCalib.ZbbyCalib_config import ZbbyCalib_branches
from XbbCalib.ZbbyCalib_config import ZbbyCalib_cfg
from XbbCalib.ZbbjCalib_config import ZbbjCalib_branches
from XbbCalib.ZbbjCalib_config import ZbbjCalib_cfg
from XbbCalib.ZlljCalib_config import ZlljCalib_branches
from XbbCalib.ZlljCalib_config import ZlljCalib_cfg
from XbbCalib.ZllyCalib_config import ZllyCalib_branches
from XbbCalib.ZllyCalib_config import ZllyCalib_cfg
from XbbCalib.ZtautauCalib_config import ZtautauCalib_branches
from XbbCalib.ZtautauCalib_config import ZtautauCalib_cfg
from EasyjetHub.algs.event_counter_config import event_counter_cfg

def XbbCalib_job_cfg():
    parser = AnalysisArgumentParser()

    # Require that the input files have no warnings
    warnings.simplefilter("error", TextConfigWarning)

    # Fill the configuration flags from the
    # parsed arguments
    # Returned flags are locked
    flags, args = analysis_configuration(parser)

    # Get a standard ComponentAccumulator with the following infrastructure:
    # - basic services for event loop, messaging etc
    # - apply preselection on triggers and data quality
    # - build event info with calibrations etc
    seqname = "XbbCalibSeq"
    cfg = default_sequence_cfg(flags, seqname)


    # Extend the list of output branches via flags
    # For more sophistication this could be done using
    # custom BranchManagers
    extra_XbbCalib_branches = []
    if flags.Analysis.do_ttCalib:
        extra_XbbCalib_branches,float_variable_names,int_variable_names = ttCalib_branches(flags)

        cfg.merge(
            ttCalib_cfg(
                flags,
                smalljetkey=flags.Analysis.container_names.output.reco4PFlowJet,
                largejetkey=flags.Analysis.container_names.output.reco10UFOJet,
                muonkey=flags.Analysis.container_names.output.muons,
                electronkey=flags.Analysis.container_names.output.electrons,
                float_variables=float_variable_names,
                int_variables=int_variable_names,
            ),
            seqname
        )
        cfg.merge(event_counter_cfg("n_ttCalib"), seqname)

    elif flags.Analysis.do_ZbbyCalib:
        extra_XbbCalib_branches,float_variable_names,int_variable_names = ZbbyCalib_branches(flags)

        cfg.merge(
            ZbbyCalib_cfg(
                flags,
                smalljetkey=flags.Analysis.container_names.output.reco4PFlowJet,
                largejetkey=flags.Analysis.container_names.output.reco10UFOJet,
                muonkey=flags.Analysis.container_names.output.muons,
                electronkey=flags.Analysis.container_names.output.electrons,
                photonkey=flags.Analysis.container_names.output.photons,
                float_variables=float_variable_names,
                int_variables=int_variable_names,
            ),
            seqname
        )

        cfg.merge(event_counter_cfg("n_ZbbyCalib"), seqname)
    elif flags.Analysis.do_ZbbjCalib:
        extra_XbbCalib_branches,float_variable_names,int_variable_names = ZbbjCalib_branches(flags)

        cfg.merge(
            ZbbjCalib_cfg(
                flags,
                largejetkey=flags.Analysis.container_names.output.reco10UFOJet,
                float_variables=float_variable_names,
                int_variables=int_variable_names,
            ),
            seqname
        )
        cfg.merge(event_counter_cfg("n_ZbbjCalib"), seqname)
    elif flags.Analysis.do_ZlljCalib:
        extra_XbbCalib_branches,float_variable_names,int_variable_names = ZlljCalib_branches(flags)

        cfg.merge(
            ZlljCalib_cfg(
                flags,
                largejetkey=flags.Analysis.container_names.output.reco10UFOJet,
                muonkey=flags.Analysis.container_names.output.muons,
                electronkey=flags.Analysis.container_names.output.electrons,
                float_variables=float_variable_names,
                int_variables=int_variable_names,
            ),
            seqname
        )
        cfg.merge(event_counter_cfg("n_ZlljCalib"), seqname)
    elif flags.Analysis.do_ZllyCalib:
        extra_XbbCalib_branches,float_variable_names,int_variable_names = ZllyCalib_branches(flags)

        cfg.merge(
            ZllyCalib_cfg(
                flags,
                largejetkey=flags.Analysis.container_names.output.reco10UFOJet,
                muonkey=flags.Analysis.container_names.output.muons,
                electronkey=flags.Analysis.container_names.output.electrons,
                photonkey=flags.Analysis.container_names.output.photons,
                float_variables=float_variable_names,
                int_variables=int_variable_names,
            ),
            seqname
        )
        cfg.merge(event_counter_cfg("n_ZllyCalib"), seqname)

    elif flags.Analysis.do_ZtautauCalib:
        extra_XbbCalib_branches,float_variable_names,int_variable_names = ZtautauCalib_branches(flags)

        cfg.merge(
            ZtautauCalib_cfg(
                flags,
                largejetkey=flags.Analysis.container_names.output.reco10UFOJet,
                taukey=flags.Analysis.container_names.output.taus,
                photonkey=flags.Analysis.container_names.output.photons,
                muonkey=flags.Analysis.container_names.output.muons,
                electronkey=flags.Analysis.container_names.output.electrons,
                float_variables=float_variable_names,
                int_variables=int_variable_names,
            ),
            seqname
        )
        cfg.merge(event_counter_cfg("n_ZtautauCalib"), seqname)
    # Explicitly call the minituple config because we want to provide
    # additional branches, the list of which is generated dynamically
    # rather than statically in the yaml
    outcfg, ntuple_output_file_list = output_cfg(
        flags,
        seqname,
        extra_XbbCalib_branches)
    cfg.merge(outcfg)

    # Record the number of events for logging and tests
    cfg.merge(event_counter_cfg("n_events"), seqname)

    return cfg, flags, args, ntuple_output_file_list


def main():
    # record the total run time
    starttime = time.process_time()

    cfg, flags, args, ntuple_output_file_list = XbbCalib_job_cfg()

    if args.dry_run:
        return_code = BootstrapHelper.StatusCode(True)
    else:
        return_code = run_job(flags, args, cfg)
        from os import environ
        outpklfile = environ.get("PICKLECAFILE", None) # check if --stop-after-config
        if return_code and outpklfile is None:
            check_ntuple_output_file(ntuple_output_file_list)

    # this is for unit tests: if jobs run too long something is wrong
    if args.timeout:
        duration = time.process_time() - starttime
        if duration > args.timeout:
            raise RuntimeError(
                f"runtime ({duration:.1f}s) exceed timeout ({args.timeout:.0f}s)"
            )
    return return_code.isSuccess()


# Execute the main function if this file was executed as a script
if __name__ == "__main__":
    is_successful = main()
    sys.exit(0 if is_successful else 1)
