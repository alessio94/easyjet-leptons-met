####################################################################################
# Title :
# Smooth W/Z Tagger Config File for VanillaSD jets === DisCoJet Tagger
#
# Author :
# Config file and tagger: Antonio Giannini <antonio.giannini@cern.ch>
#
# Description :
# The simple W/Z tagger provides four smoothed cut functions :
# - a lower cut on the jet mass 
# - an upper cut on the jet mass
# - an upper cut on DisCoJet score
#
# Jets:
#   anti-kt R = 1.0 jets using UFOs as inputs (pile-up corrected with CSSK)
#   Grooming: Soft Drop algorithm with beta = 1 and z_cut = 0.1
#
# The smoothed cut functions are parameterized in units of ! [GeV] ! for pT and mass
#
#
# Tagger Descriptions :
# - Fully contained W tagger 
# - optimized for a flat signal efficiency of 50% in W' => WZ sample
####################################################################################

DecorationName: SmoothVContainedHPDisCoJet

pTCutLow: 200.0

pTCutHigh: 3000.0

MassCutLow: (3.e+1)

MassCutHigh: (1.e+11)

ScoreCut: (9.0e-01)

ConstTaggerFileName: ONNXModel_VVJJ_Model_m175RScaling_19nov22.onnx

nPixelsEta: 40
aEta: -1.
bEta: 1.
nPixelsPhi: 40
aPhi: -1.
bPhi: 1.
nColors: 3
DoRScaling: 1
### the jet pT is in MeV
RScaling_p0: 0.0761
RScaling_p1: 379.e+3

### DisCo model
HLTaggerFileName: ONNXModel_VVJJ_Model_DisCoJet_v3p4_29jan23.onnx

