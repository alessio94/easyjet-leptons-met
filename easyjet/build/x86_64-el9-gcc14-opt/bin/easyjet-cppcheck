#!/usr/bin/env bash

set -Eeu

print-usage() {
    echo "usage: ${0##*/} <easyjet source directory>"
}

usage() {
    print-usage
    exit 1;
}

help() {
    echo "The ${0##*/} utility will run cppcheck on the easyjet source directory."
    print-usage
    exit 0
}


while getopts "h" o; do
    case "${o}" in
        h) help ;;
        *) usage ;;
    esac
done
shift $((OPTIND-1))

if (( $# != 1 )) ; then
    usage
fi

easyjetsource=$1

/cvmfs/atlas.cern.ch/repo/ATLASLocalRootBase/x86_64/cppcheck/current/cppcheck*/bin/cppcheck \
--check-level=exhaustive --xml-version=2 --error-exitcode=1 \
--enable=warning,portability,performance \
-D "DECLARE_COMPONENT(type)=void()" \
-D "ANA_MSG_HEADER(name)=void()" \
-D "ANA_MSG_SOURCE(name,title)=void()" \
--suppress="iterateByValue:$easyjetsource/VBFTagger/Root/VBFTagger.cxx" \
$easyjetsource
