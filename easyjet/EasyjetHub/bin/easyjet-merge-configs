#!/usr/bin/env python3

"""
Merge some config files as a test
"""

from EasyjetHub.steering.utils.config_files import run_config_arg
from argparse import ArgumentParser
import yaml

def get_args():
    parser = ArgumentParser(description=__doc__)
    parser.add_argument("config_file", type=run_config_arg)
    return parser.parse_args()

def run():
    args = get_args()
    print(yaml.dump(args.config_file, indent=2))

if __name__ == '__main__':
    run()
