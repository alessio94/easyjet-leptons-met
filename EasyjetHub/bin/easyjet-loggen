#!/usr/bin/env bash

set -eu

function usage() {
    echo "usage: ${0##*/} [--help|--last] <since> [to]"
}
function help() {
    usage
    echo ""
    cat <<EOF
Return a list of commits, by package, since <since>, and until
<to>. If not specified, <to> defaults to HEAD.

Options:
 --help: print help
 --last: show changes between last tag and HEAD

EOF
}

if (( $# == 0 || $# > 2 ))
then
    usage
    exit 1
fi

if [[ $1 == --help ]]
then
    help
    exit 0
elif [[ $1 == --last ]]
then
    RANGE=$(git tag -l --sort=-taggerdate  | head -n1)..
elif [[ $1 == -* ]]
then
    echo "ERROR: unknown argument $1" >&2
    exit 1
else
    for rev in ${@}
    do
        if ! git rev-parse --quiet --verify ${rev} > /dev/null
        then
            usage
            echo "ERROR: invalid revision '${rev}'" >&2
            exit 1
        fi
    done
    RANGE=${1}..${2-}
fi


# move to the project
cd $(dirname $(readlink -f ${BASH_SOURCE[0]}))
cd $(git rev-parse --show-toplevel)

for pkg in */
do
    echo ${pkg%/}:
    git --no-pager log --pretty='format:- %s' ${RANGE} -- $pkg
    echo -e "\n"
done
